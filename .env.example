# IMPORTANT for SEO: your real domain, with https and no trailing slash. Example: https://www.pixelog.in
NEXT_PUBLIC_SITE_URL=https://www.pixelog.in
# Optional: Google Search Console verification code (HTML tag method, only the content value)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
CONTACT_FORM_ENDPOINT=
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Contact form via EmailJS (https://www.emailjs.com). Copy to .env.local and fill in. Leave empty to use FormSubmit instead.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
